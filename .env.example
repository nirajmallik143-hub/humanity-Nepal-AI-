# Local development only. Copy to .env and replace every placeholder.
# Never commit .env or put provider secrets in frontend code.
MALLIK_GROUP_CODE=replace-with-a-long-random-private-group-code

# Select exactly one provider (gemini or openai).
AI_PROVIDER=gemini
GEMINI_API_KEY=paste-your-gemini-api-key-here
# Optional Gemini model; defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# For OpenAI instead, set AI_PROVIDER=openai and configure these:
# OPENAI_API_KEY=paste-your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini
